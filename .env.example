# Supabase — get from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="your-publishable-key"

# Service-role key — needed by the MCP tool server (api/_lib/supabase/admin.ts) to bypass
# RLS, since remote MCP calls carry no browser session.
SUPABASE_SERVICE_ROLE_KEY="your-secret-key"

# MCP server — bearer token required to call /api/mcp (used by claude.ai custom connector).
# Also doubles as the signing key for the OAuth shim (api/oauth/*) and is the literal
# access/refresh token it hands back once claude.ai completes the OAuth flow.
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN="your-long-random-secret"

# Passphrase gate for api/oauth/authorize.ts — since this app has no server-readable
# session, /authorize asks for this instead of checking a cookie.
MCP_AUTHORIZE_PASSPHRASE="your-passphrase"
