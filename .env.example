# DreamShape runs as one Node app (Express): it serves the Vite build, the JSON API under /api
# and the MCP endpoint. Locally copy this file to .env; on Hostinger set the same names under the
# Node.js app's environment variables. Nothing here is exposed to the browser.

# MySQL / MariaDB (hPanel -> Databases -> MySQL Databases).
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE  (URL-encode special characters in the password)
# On the Hostinger Node.js app use 127.0.0.1 as HOST, not "localhost" (localhost can resolve to ::1).
# From your own machine (migrations, data copy) use the remote host from hPanel and allow your IP
# under "Remote MySQL".
DATABASE_URL="mysql://u123_dreamshape:password@127.0.0.1:3306/u123_dreamshape"

# Signs the login session cookie (HMAC). Generate with: openssl rand -hex 32
# Changing it logs every device out.
SESSION_SECRET="your-long-random-secret"

# MCP server: bearer token required to call /api/mcp (claude.ai custom connector).
# Also the signing key of the OAuth shim (/api/oauth/*) and the literal access/refresh token it
# hands back once claude.ai completes the OAuth flow. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN="your-long-random-secret"

# Passphrase asked for by /api/oauth/authorize when claude.ai connects.
MCP_AUTHORIZE_PASSPHRASE="your-passphrase"

# --- Optional -------------------------------------------------------------------------------
# Sign-up code for the "Sign Up" tab. Leave unset to keep sign-up switched off (single-user app).
# Accounts can also be created with: npm run create-user -- you@example.com "password" "Name" creator
# AUTH_SIGNUP_CODE="choose-a-code"

# The MCP tools act on one user. Default: the oldest account. Pin it with that user's id:
# MCP_USER_ID="00000000-0000-0000-0000-000000000000"

# Local dev only: port of the API (Vite proxies /api to it). Hostinger sets PORT itself.
# PORT=3001

# --- Only for the one-off data copy (npm run db:copy-from-supabase) -------------------------
# The old Supabase Postgres connection string (Settings -> Database). Remove after the migration.
# SOURCE_DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
